    {
      "name": "Smoke / End-to-End Flow",
      "description": "Run this whole folder in order via Postman Runner or `newman run` to exercise the full passenger journey: register \u2192 login \u2192 search \u2192 book \u2192 pay \u2192 check in \u2192 register baggage \u2192 fetch notifications.\n\nThis is the integration check the marker can fire in one click.",
      "item": [
        {
          "name": "1. Register a new user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
