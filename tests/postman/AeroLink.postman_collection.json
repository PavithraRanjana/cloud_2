    {
      "name": "Payments",
      "description": "Stripe-backed payments. Idempotent intent creation; webhook is signed by Stripe in production.",
      "item": [
        {
          "name": "Create payment intent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": \"{{bookingId}}\",\n  \"amount\": 29999,\n  \"currency\": \"usd\",\n  \"idempotency_key\": \"postman-{{$guid}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/intent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "intent"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is in expected set (200,201,400,401,422)', () => pm.expect([200,201,400,401,422]).to.include(pm.response.code));",
                  "if ([200,201].includes(pm.response.code)) {",
                  "  const body = pm.response.json();",
                  "  if (body.payment_intent_id) pm.collectionVariables.set('paymentIntentId', body.payment_intent_id);",
