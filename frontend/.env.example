# ── Cognito Hosted UI (production) ──────────────────────────────────────────
# Set these for production builds. Leave empty for local dev (LocalStack mode).
VITE_COGNITO_DOMAIN=
# e.g. aerolink-prod.auth.eu-west-1.amazoncognito.com  (no https://)

VITE_COGNITO_CLIENT_ID=
# App Client ID from CloudFormation output: CognitoUserPoolClientId

VITE_COGNITO_REDIRECT_URI=
# Defaults to {window.origin}/callback — override only if needed

VITE_COGNITO_REGION=eu-west-1

# ── Local dev (LocalStack) ───────────────────────────────────────────────────
# Run scripts/setup-local-cognito.sh after docker-compose up to auto-fill these.
# VITE_COGNITO_CLIENT_ID=  (same field, set from infrastructure/localstack/cognito.env)
# VITE_COGNITO_USER_POOL_ID=  (informational only, not required at runtime)
VITE_LOCALSTACK_URL=http://localhost:4566
