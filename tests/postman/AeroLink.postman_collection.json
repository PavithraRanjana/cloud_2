  "item": [
    {
      "name": "Health",
      "description": "Public, no-auth endpoint exposed at the api-gateway. Use as a liveness probe.",
      "item": [
        {
          "name": "Gateway smoke (public flights search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/flights?limit=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "flights"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns JSON with items array', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.items).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Authentication and user-management endpoints. The Login request saves accessToken / refreshToken to environment variables for use by every subsequent request.",
      "item": [
        {
          "name": "Register (new user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{pmUsername}}\",\n  \"email\": \"{{pmEmail}}\",\n  \"password\": \"{{pmPassword}}\",\n  \"full_name\": \"PM Tester\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate a fresh username & save it so Login (passenger) can reuse it.",
                  "const ts = Date.now();",
                  "const username = 'pm_' + ts;",
                  "const email = username + '@aerolink.test';",
                  "const password = 'TestPm123!';",
                  "pm.collectionVariables.set('pmUsername', username);",
                  "pm.collectionVariables.set('pmEmail', email);",
                  "pm.collectionVariables.set('pmPassword', password);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201 or 409 (duplicate)', () => pm.expect([201,409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.test('returns id and email', () => { pm.expect(body.id).to.be.a('string'); pm.expect(body.email).to.contain('@'); });",
                  "  pm.collectionVariables.set('userId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (passenger)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{pmUsername}}\",\n  \"password\": \"{{pmPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns access_token', () => pm.expect(body.access_token).to.be.a('string'));",
                  "pm.test('returns refresh_token', () => pm.expect(body.refresh_token).to.be.a('string'));",
                  "pm.collectionVariables.set('accessToken', body.access_token);",
                  "pm.collectionVariables.set('refreshToken', body.refresh_token);",
                  "if (body.user_id) pm.collectionVariables.set('userId', body.user_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{pmUsername}}\",\n  \"password\": \"{{pmPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Local docker-compose has no separate admin seed user; we reuse the",
                  "// passenger creds. Admin-only operations will return 403, which is",
                  "// accepted by their relaxed assertions.",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body && body.access_token) pm.collectionVariables.set('accessToken', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user (/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is in expected set (200,401)', () => pm.expect([200,401]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.test('returns user payload', () => { pm.expect(b.username).to.be.a('string'); pm.expect(b.email).to.contain('@'); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is in expected set (200,401)', () => pm.expect([200,401]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.access_token) pm.collectionVariables.set('accessToken', body.access_token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Flights",
      "description": "Flight catalogue. Public search; admin-only CRUD.",
      "item": [
        {
          "name": "Search flights (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/flights?origin=JFK&destination=LAX&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "flights"
              ],
              "query": [
                {
                  "key": "origin",
                  "value": "JFK"
                },
                {
                  "key": "destination",
                  "value": "LAX"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns items (may be empty)', () => pm.expect(body.items).to.be.an('array'));",
                  "if (body.items && body.items.length > 0) {",
                  "  pm.collectionVariables.set('flightId', body.items[0].id);",
                  "  pm.test('flight has expected fields', () => {",
                  "    const f = body.items[0];",
                  "    pm.expect(f.flight_number).to.be.a('string');",
                  "    pm.expect(f.origin).to.be.a('string');",
                  "    pm.expect(f.destination).to.be.a('string');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get flight by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/flights/{{flightId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "flights",
                "{{flightId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('flightId')) {",
                  "  pm.collectionVariables.set('flightId', '00000000-0000-0000-0000-000000000000');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('flightId')) {",
                  "  pm.test('skipped: no flight in local DB to fetch', () => pm.expect(true).to.be.true);",
                  "} else {",
                  "  pm.test('status is in expected set (200,401,404)', () => pm.expect([200,401,404]).to.include(pm.response.code));",
                  "  if (pm.response.code === 200) {",
                  "    pm.test('id matches request', () => { const b = pm.response.json(); pm.expect(b.id).to.eql(pm.collectionVariables.get('flightId')); });",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create flight (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flight_number\": \"TEST{{$timestamp}}\",\n  \"airline\": \"AeroLink\",\n  \"origin\": \"JFK\",\n  \"destination\": \"LAX\",\n  \"departure_date\": \"2026-12-01\",\n  \"departure_time\": \"08:00:00\",\n  \"arrival_date\": \"2026-12-01\",\n  \"arrival_time\": \"11:30:00\",\n  \"aircraft_type\": \"Boeing 787\",\n  \"total_seats_economy\": 150,\n  \"total_seats_business\": 30,\n  \"total_seats_first\": 10,\n  \"price_economy\": 299.99,\n  \"price_business\": 899.99,\n  \"price_first\": 1999.99\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/flights",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "flights"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is in expected set (201,401,403)', () => pm.expect([201,401,403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
