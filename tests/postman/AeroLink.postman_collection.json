                  "pm.collectionVariables.set('e2eEmail', u + '@aerolink.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register returns 201', () => pm.response.to.have.status(201));"
